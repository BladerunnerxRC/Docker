# 3DPrintForge runtime variables
# Docker Compose auto-loads only a file named .env by default.
# With this filename, run locally with: docker compose --env-file 3dprintforge.env up -d
# In Portainer, set variables in the stack Environment variables settings.
NODE_ENV=production
TZ=America/New_York

# Optional initial/default printer values
BAMBU_IP=192.168.1.100
BAMBU_SERIAL=01S00A000000000
BAMBU_ACCESS_CODE=12345678
