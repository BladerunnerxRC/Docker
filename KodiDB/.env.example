# MariaDB backend for Kodi shared library
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# In Portainer, paste these into Stack -> Environment variables instead.

# --- Credentials ---
#
# !! USE ALPHANUMERIC PASSWORDS ONLY !!
#
# These values pass through three layers that each treat punctuation as syntax,
# and every one of them fails silently — you get "Access denied ... (using
# password: YES)" with no hint that the string was mangled in transit:
#
#   $         Compose and Portainer interpolate values. A password of FW#$Fg2435G
#             becomes FW# because $Fg2435G is read as an undefined variable.
#             Escape as $$ if you must, but it is easy to get wrong twice.
#   #         Starts a comment in some .env parsers.
#   & < >     Must be XML-escaped (&amp; &lt; &gt;) in advancedsettings.xml,
#             where Kodi reads the same password back.
#
# Length is a better defence than symbol soup here. Use a long A-Za-z0-9 string.
#
# Changing these later does NOT change the running database: MariaDB only reads
# them when the kodi-db-data volume is first initialized. To rotate afterwards,
# run ALTER USER against the live server as well. See the README.
MARIADB_ROOT_PASSWORD=change_this_root_password
MARIADB_USER=kodi
MARIADB_PASSWORD=change_this_kodi_password

# --- Runtime ---
TZ=America/New_York
MARIADB_PORT=3306

# --- Tuning ---
# InnoDB cache size. Raise if the Docker host has RAM to spare (e.g. 1G, 2G).
INNODB_BUFFER_POOL_SIZE=512M

# --- Backups ---
# This stack takes no backups. Borg does, by calling borg-prep-kodidb.sh on the
# Docker host before each run. Retention is set by Borg's prune policy, not here.
