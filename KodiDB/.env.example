# MariaDB backend for Kodi shared library
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# In Portainer, paste these into Stack -> Environment variables instead.

# --- Credentials ---
MARIADB_ROOT_PASSWORD=change_this_root_password
MARIADB_USER=kodi
MARIADB_PASSWORD=change_this_kodi_password

# --- Runtime ---
TZ=America/New_York
MARIADB_PORT=3306

# --- Tuning ---
# InnoDB cache size. Raise if the Docker host has RAM to spare (e.g. 1G, 2G).
INNODB_BUFFER_POOL_SIZE=512M

# --- Backups ---
# How many days of nightly dumps to keep
BACKUP_RETENTION_DAYS=14

# --- NAS (NFS target for backups) ---
# IP or hostname of the NFS server.
NAS_HOST=192.168.1.10
# NFS export path WITHOUT a trailing /backups — compose appends it.
# The folder NAS_EXPORT/backups must exist on the NAS before deploying.
NAS_EXPORT=/volume1/docker/kodi-db
