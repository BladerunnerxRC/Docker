# edge-stack environment
#
# Every one of these has a matching default baked into compose.yaml, so the
# stack deploys correctly with NO variables set. Copy to .env (or paste into
# Portainer's stack env vars) only if you need to override a path.
#
# Do NOT commit a real .env — it is gitignored.

# --- identity -----------------------------------------------------------
BASE_DOMAIN=shome
CERTRESOLVER=stepca

# --- traefik bind mounts ------------------------------------------------
TRAEFIK_YML=/opt/netlab-stack/traefik/traefik.yml
TRAEFIK_DYNAMIC=/opt/netlab-stack/traefik/dynamic
TRAEFIK_CERTS=/opt/netlab-stack/traefik/certs
TRAEFIK_ACME=/opt/netlab-stack/traefik/acme
TRAEFIK_STEPCA=/opt/netlab-stack/traefik/stepca
TRAEFIK_HTPASSWD=/opt/netlab-stack/traefik/auth/.htpasswd

# Broken as configured (points at a directory, not a file). Kept to match the
# running container. See README "Known cruft".
TRAEFIK_KUBECONFIG=/opt/netlab-stack/traefik/kubeconfig

# --- dashboard access ---------------------------------------------------
# CIDRs allowed to reach traefik.shome/dashboard and /api.
TRAEFIK_DASHBOARD_ALLOWLIST=192.168.200.0/24,192.168.0.0/16

# --- adguard bind mounts ------------------------------------------------
ADGUARD_CONF=/opt/netlab-stack/adguard/conf
ADGUARD_WORK=/opt/netlab-stack/adguard/work
