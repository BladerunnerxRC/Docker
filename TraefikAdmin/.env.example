# Traefik Proxy Admin — stack configuration
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# In Portainer, paste these into Stack -> Environment variables instead.

# --- Routing (must match the traefik/ stack) ---
BASE_DOMAIN=shome
CERTRESOLVER=stepca

# Subdomain the panel is published on: <TPADMIN_HOST>.<BASE_DOMAIN>.
# Pick a name that is NOT already claimed in traefik/dynamic/20-routers.yml.
# Currently taken: traefik, dns, whoami, dockhand, haos, komga, manyfold3d,
# portainer, portainer-2, porttracker, webmin-*, borg-optiplex-docker, wud.
TPADMIN_HOST=tpadmin

# Source ranges allowed to reach the panel, comma-separated CIDRs.
# This is a real access control, not a convenience — see the credentials note below.
TPADMIN_ALLOWLIST=192.168.200.0/24,192.168.0.0/16

# --- Database ---
#
# !! USE AN ALPHANUMERIC PASSWORD ONLY !!
#
# This value is substituted into a PostgreSQL connection URL:
#
#   postgresql://USER:PASSWORD@traefik-proxy-admin-db:5432/DB
#
# so it passes through two layers that both treat punctuation as syntax, and both
# fail in confusing ways:
#
#   $               Compose and Portainer interpolate values before Docker sees them.
#                   A password of Ab#$Cd1234 becomes Ab# because $Cd1234 is read as an
#                   undefined variable. Escape as $$ if you must — easy to get wrong.
#   @ : / ? # &     Structural characters in a URL. An @ splits userinfo from host, so
#                   the app tries to connect to whatever follows it and reports a DNS
#                   or "connection refused" error that says nothing about the password.
#   %               Starts a percent-escape; a stray %2 is a malformed escape sequence.
#
# Length beats symbol soup here. Use a long A-Za-z0-9 string.
#
# Changing these later does NOT change the running database: Postgres only reads them
# when tpadmin_db_data is first initialized. To rotate afterwards, run ALTER USER
# against the live server as well — see the README.
POSTGRES_DB=traefik_admin
POSTGRES_USER=tpadmin
POSTGRES_PASSWORD=changeMeToALongAlphanumericString

# Connection pool size. The app default is 10; the panel is low-traffic and rarely
# needs more.
DB_CONNECTION_LIMIT=10

# --- Runtime ---
TZ=America/New_York

# --- Not set here ---
# The panel has no login of its own. Access control is the BasicAuth middleware in
# docker-compose.yml, which reads the .htpasswd the traefik stack already mounts at
# /opt/netlab-stack/traefik/auth/.htpasswd. Add a user there, not here.
#
# Everything else — domains, cert resolvers per domain, the default entrypoint, the
# admin panel address used for forward-auth, SSO — is configured in the web UI and
# stored in Postgres, not in environment variables. See README.md -> First-run setup.
