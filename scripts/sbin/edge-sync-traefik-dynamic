#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# edge-sync-traefik-dynamic
#
# Output:
#   Clean step output on screen (==[x/8] ...==)
# Logging:
#   - Main log: /var/log/edge-sync/edge-sync-traefik-dynamic.log
#   - Per-run:   /var/log/edge-sync/edge-sync-traefik-dynamic-YYYYmmdd-HHMMSS.log
#
# Behavior:
#   - Pull-only server: hard reset repo to origin/main as user "thomas"
#   - Backup live dynamic folder
#   - Rsync repo dynamic -> live dynamic (delete removed files)
#   - Validate YAML (REQUIRED)
#   - Restart Traefik
#   - Wait for Traefik API
#   - List file-provider routers + middlewares + live dir listing
# -----------------------------------------------------------------------------

REPO="/opt/git/Docker"
SRC="${REPO}/stacks/edge-stack/traefik/dynamic"
DST="/opt/netlab-stack/traefik/dynamic"
BK="/opt/netlab-stack/traefik/backups"

TRAEFIK_CONTAINER="${TRAEFIK_CONTAINER:-traefik}"
TRAEFIK_URL="${TRAEFIK_URL:-https://127.0.0.1:8080}"
WAIT_SECONDS="${WAIT_SECONDS:-25}"

# Optional curl SNI->IP override if needed:
# TRAEFIK_RESOLVE=(--resolve "traefik.lab.local:443:127.0.0.1")
TRAEFIK_RESOLVE=()

LOG_DIR="/var/log/edge-sync"
LOG_MAIN="${LOG_DIR}/edge-sync-traefik-dynamic.log"
LOG_RUN="${LOG_DIR}/edge-sync-traefik-dynamic-$(date +%Y%m%d-%H%M%S).log"

step() { echo "==[$1] $2 =="; }
die()  { echo "ERROR: $*" >&2; exit 1; }

need_root() { [[ "${EUID}" -eq 0 ]] || die "run as root: sudo $0"; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

on_err() {
  local code=$?
  echo "ERROR: FAILED (exit=$code) at line ${BASH_LINENO[0]}: ${BASH_COMMAND}" >&2
  echo "ERROR: See log: $LOG_RUN" >&2
  exit "$code"
}
trap on_err ERR

validate_yaml() {
  # REQUIRED: fail the run if YAML is invalid.
  # Requires: python3 + python3-yaml
  python3 - <<'PY'
import glob, sys
try:
    import yaml
except Exception:
    print("ERROR: PyYAML not installed. Install: sudo apt-get install -y python3-yaml", file=sys.stderr)
    sys.exit(11)

dst = "/opt/netlab-stack/traefik/dynamic"
files = sorted(
    glob.glob(dst + "/**/*.yml", recursive=True) +
    glob.glob(dst + "/**/*.yaml", recursive=True)
)

bad = []
for f in files:
    try:
        with open(f, "r", encoding="utf-8") as fp:
            yaml.safe_load(fp)
    except Exception as e:
        bad.append((f, str(e)))

if bad:
    print("ERROR: YAML validation failed:")
    for f, e in bad:
        print(f" - {f}: {e}")
    sys.exit(12)

print(f"OK: YAML validated ({len(files)} files)")
PY
}

# --- requirements ---
need_root
need git
need rsync
need tar
need docker
need curl
need jq
need python3

mkdir -p "$LOG_DIR"
touch "$LOG_MAIN" "$LOG_RUN"
chmod 0644 "$LOG_MAIN" "$LOG_RUN"

# Capture EVERYTHING (stdout+stderr) to:
#   - console
#   - main log
#   - per-run log
exec > >(tee -a "$LOG_MAIN" | tee -a "$LOG_RUN") 2>&1

echo "run_log=$LOG_RUN"

step "0/9" "Ensure root trusts GitHub host key (non-interactive)"
ssh-keyscan -H github.com >>/root/.ssh/known_hosts 2>/dev/null || true

step "1/9" "Sync repo clone to origin/main (git as thomas)"
cd "$REPO"
sudo -u thomas git fetch origin
sudo -u thomas git checkout -q main
sudo -u thomas git reset --hard origin/main

step "2/9" "Sanity checks"
[[ -d "$SRC" ]] || die "missing source dir: $SRC"
mkdir -p "$DST" "$BK"

step "3/9" "Backup live dynamic folder"
BK_TGZ="${BK}/dynamic-live-$(date +%Y-%m-%d-%H%M%S).tgz"
tar -czf "$BK_TGZ" -C "$(dirname "$DST")" "$(basename "$DST")" || true
echo "backup_created=$BK_TGZ"

step "4/9" "Move live backup dir out of watched folder (if present)"
if [[ -d "${DST}/backups" ]]; then
  mv -f "${DST}/backups" "/opt/netlab-stack/traefik/backups-in-dynamic-$(date +%Y%m%d-%H%M%S)" || true
  echo "moved_backups_dir_out_of_dynamic"
else
  echo "no_live_backup_dir_found"
fi

step "5/9" "Rsync repo -> live (delete removed files)"
rsync -a --delete --itemize-changes "${SRC}/" "${DST}/" || true

step "6/9" "Validate YAML in live dynamic folder (REQUIRED)"
validate_yaml

step "7/9" "Restart Traefik"
docker restart "$TRAEFIK_CONTAINER" >/dev/null
echo "traefik_restarted"

step "8/9" "Wait for Traefik API (up to ${WAIT_SECONDS}s)"
for i in $(seq 1 "$WAIT_SECONDS"); do
  if curl -kfsS "${TRAEFIK_RESOLVE[@]}" "$TRAEFIK_URL/api/overview" >/dev/null 2>&1; then
    echo "Traefik API is up."
    break
  fi
  sleep 1
  if [[ "$i" -eq "$WAIT_SECONDS" ]]; then
    echo "ERROR: Traefik API not reachable after ${WAIT_SECONDS}s" >&2
    docker logs --tail 200 "$TRAEFIK_CONTAINER" || true
    exit 25
  fi
done

step "9/9" "Verify file-provider routers + middlewares"
echo "-- File routers:"
curl -kfsS "${TRAEFIK_RESOLVE[@]}" "$TRAEFIK_URL/api/http/routers" \
| jq -r 'map(select(.provider=="file")) | map(.name) | sort | .[]' || true

echo "-- File middlewares:"
curl -kfsS "${TRAEFIK_RESOLVE[@]}" "$TRAEFIK_URL/api/http/middlewares" \
| jq -r 'map(select(.provider=="file")) | map(.name) | sort | .[]' || true

echo "-- Live dynamic dir:"
ls -la "$DST" || true

echo "DONE."
