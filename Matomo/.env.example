# Matomo — stack configuration
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# In Portainer, paste these into Stack -> Environment variables instead.

# --- Routing (must match the traefik/ stack) ---
BASE_DOMAIN=shome
CERTRESOLVER=stepca

# Subdomain Matomo is published on: <MATOMO_HOST>.<BASE_DOMAIN>.
# Pick a name that is NOT already claimed in traefik/dynamic/20-routers.yml.
MATOMO_HOST=matomo

# Source ranges allowed to reach Matomo, comma-separated CIDRs. This covers the
# tracker too: a visitor outside these ranges is silently not recorded.
MATOMO_ALLOWLIST=192.168.200.0/24,192.168.0.0/16

# --- Database ---
#
# !! USE ALPHANUMERIC PASSWORDS ONLY !!
#
# These values pass through layers that treat punctuation as syntax, and they fail
# silently — you get "Access denied ... (using password: YES)" with no hint that the
# string was mangled in transit:
#
#   $         Compose and Portainer interpolate values. A password of Ab#$Cd1234
#             becomes Ab# because $Cd1234 is read as an undefined variable.
#   #         Starts a comment in some .env parsers.
#   " ;       Matomo writes the password into config.ini.php, an INI file where
#             these are syntax.
#
# Length beats symbol soup here. Use a long A-Za-z0-9 string.
#
# Changing these later does NOT change the running database: MariaDB only reads them
# when the matomo_db volume is first initialized, and Matomo only reads them during
# the installer (afterwards the password lives in config.ini.php). To rotate, run
# ALTER USER against the live server AND update config.ini.php — see the README.
MARIADB_ROOT_PASSWORD=changeMeToALongAlphanumericRootPassword
MARIADB_DATABASE=matomo
MARIADB_USER=matomo
MARIADB_PASSWORD=changeMeToALongAlphanumericString

# --- Runtime ---
TZ=America/New_York

# PHP memory for the web app AND the archiver. Raise for large sites / long ranges.
# Keep it below the 1g container mem_limit in docker-compose.yml.
PHP_MEMORY_LIMIT=512M

# Seconds between core:archive runs. 3600 (hourly) suits a homelab; Matomo's
# realtime "Visits log" is unaffected — only the aggregated reports wait for this.
ARCHIVE_INTERVAL=3600

# --- Tuning ---
# InnoDB cache size. Raise if the Docker host has RAM to spare (stay under the
# 1g container mem_limit, or raise that too).
INNODB_BUFFER_POOL_SIZE=512M

# --- Backups ---
# This stack takes no backups. Borg does, by calling borg-prep-matomo.sh on the
# Docker host before each run. Retention is set by Borg's prune policy, not here.
